# Copy to .env.local (gitignored) or pass via docker compose / your process manager. Never commit real keys.
# Optional: DeepSeek translation of non-Chinese titles/summaries at fetch time. Unset = translation disabled.
DEEPSEEK_API_KEY=
# 1 (default) / 0 — server default for fetch-time translation; the UI switch (stored in the DB) overrides it.
TRANSLATE_ENABLED=1
# DEEPSEEK_MODEL=deepseek-chat
# TRANSLATE_BATCH=10
# TRANSLATE_CONCURRENCY=2
# TRANSLATE_SUMMARY_CHARS=1500
# Polling / storage
# RETENTION_HOURS=48
# DISABLE_POLLER=0
